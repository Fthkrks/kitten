visible:ring-2 focus-visible:ring-kar-gold focus-visible:ring-offset-2 focus-visible:ring-offset-kar-ivory\" data-profile=\"kitten-6ab9c19ae120f8ccd5cab90b\" type=\"button\"><svg aria-hidden=\"true\" class=\"lucide lucide-contact mr-1.5 shrink-0 text-kar-gold-deep\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 2v2\"></path><path d=\"M7 22v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2\"></path><path d=\"M8 2v2\"></path><circle cx=\"12\" cy=\"11\" r=\"3\"></circle><rect height=\"18\" rx=\"2\" width=\"18\" x=\"3\" y=\"4\"></rect></svg><svg aria-hidden=\"true\" class=\"lucide lucide-circle-play mr-1.5 shrink-0 text-kar-gold-deep\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polygon points=\"10 8 16 12 10 16 10 8\"></polygon></svg><span aria-hidden=\"true\">Full profile &amp; video</span><span class=\"sr-only\">Read Mystery's full profile and watch Mystery's video</span></button><div class=\"mt-auto pt-4\"><a class=\"group/button relative hover:animate-jumpeffect font-londrinaSolid inline-flex tracking-wide items-center justify-center duration-300 font-bold rounded-xl transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 before:absolute before:bottom-[-15px] before:w-[calc(100%/2)] before:h-[5px] before:left-[45%] before:rounded-[100%] before:blur-[2px] before:bg-[rgba(16,41,55,0.1)] before:-translate-x-1/2 before:transition-all before:duration-300 rounded-kar border border-kar-gold bg-kar-chocolate text-kar-ivory-bright shadow-kar-btn hover:bg-kar-chocolate-soft hover:animate-none focus-visible:ring-kar-gold ring-offset-kar-ivory px-8 py-3.5 w